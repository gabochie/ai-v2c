# Secret Management & Application Configuration

# AI Engine Credentials (Fetched from GCP Secret Manager in production)
GEMINI_API_KEY=your_gemini_api_key_here

# Local LLM (Ollama) connection. Use host.docker.internal when running in Docker.
OLLAMA_HOST=http://localhost:11434

# Ollama model selection
OLLAMA_MODEL_CODER=qwen2.5-coder:7b
OLLAMA_MODEL_GENERAL=llama3.2:latest

# OpenClaw gateway (sandboxed agentic runtime) - primary AI provider when both are set.
# Leave empty to fall back to Ollama/Gemini only.
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=

# Hermes agent gateway (fast local agentic runtime, OpenAI-compatible :8642).
# When set, Hermes is preferred over OpenClaw for agentic chat.
HERMES_GATEWAY_URL=http://127.0.0.1:8642
HERMES_API_KEY=
HERMES_MODEL=qwen2.5-coder:1.5b

# Runtime Environment Configuration
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Admin user bootstrap (generates a random one-time password if unset)
ADMIN_PASSWORD=

# Encryption key for encrypted backup/restore (required)
BACKUP_KEY=

# Observability & Tracing Configuration
ENABLE_STRUCTURED_LOGGING=true
TELEMETRY_SAMPLE_RATE=1.0

# Security & Hosting Settings
TRUST_PROXY=1
SECURE_HEADERS_ENABLED=true
